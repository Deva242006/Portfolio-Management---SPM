# Database Configuration
DB_URL=jdbc:mysql://localhost:3306/portfolio_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# Server Configuration
SERVER_PORT=8080

# File Upload Directory
UPLOAD_DIR=uploads/resumes

# JWT Security
JWT_SECRET=your_base64_or_hex_encoded_secret_key_at_least_256_bits_long
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

